# Frontend (build-time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=https://your-backend.example.com/api

# Backend
# NODE_ENV=production  # set on the host
PORT=3001
ALLOWED_ORIGINS=https://your-frontend.example.com
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
LENCO_SECRET_KEY=your-lenco-api-secret
LENCO_MOCK=false
LENCO_API_BASE=https://api.lenco.co/access/v2
LENCO_FEE_BEARER=merchant     # merchant | customer (see R4-7)

# Operator alerts (e.g. payment enters needs_review). Slack/Discord-compatible incoming webhook.
ALERT_WEBHOOK_URL=
# Max recent successes re-checked per reconciliation run
# RECONCILE_RECENT_CAP=50
